@article{tcrest,
abstract = {Real-time systems need time-predictable platforms to allow static analysis of the worst-case execution time (WCET). Standard multi-core processors are optimized for the average case and are hardly analyzable. Within the T-CREST project we propose novel solutions for time-predictable multi-core architectures that are optimized for the WCET instead of the average-case execution time. The resulting time-predictable resources (processors, interconnect, memory arbiter, and memory controller) and tools (compiler, WCET analysis) are designed to ease WCET analysis and to optimize WCET performance. Compared to other processors the WCET performance is outstanding.
The T-CREST platform is evaluated with two industrial use cases. An application from the avionic domain demonstrates that tasks executing on different cores do not interfere with respect to their WCET. A signal processing application from the railway domain shows that the WCET can be reduced for computation-intensive tasks when distributing the tasks on several cores and using the network-on-chip for communication. With three cores the WCET is improved by a factor of 1.8 and with 15 cores by a factor of 5.7.
The T-CREST project is the result of a collaborative research and development project executed by eight partners from academia and industry. The European Commission funded T-CREST.},
author = {Schoeberl, Martin and Abbaspour, Sahar and Akesson, Benny and Audsley, Neil and Capasso, Raffaele and Garside, Jamie and Goossens, Kees and Goossens, Sven and Hansen, Scott and Heckmann, Reinhold and Hepp, Stefan and Huber, Benedikt and Jordan, Alexander and Kasapaki, Evangelia and Knoop, Jens and Li, Yonghui and Prokesch, Daniel and Puffitsch, Wolfgang and Puschner, Peter and Rocha, André and Silva, Cláudio and Sparsø, Jens and Tocchi, Alessandro},
address = {Amsterdam},
copyright = {2015 Elsevier B.V.},
issn = {1383-7621},
journal = {Journal of systems architecture},
keywords = {Integrated circuits ; Signal processing ; Realtime . . . ; Computer software ; Software engineering},
language = {eng},
number = {9},
pages = {449-471},
publisher = {Elsevier B.V},
title = {{T-CREST: Time-predictable multi-core architecture for embedded systems}},
volume = {61},
year = {2015},
}

